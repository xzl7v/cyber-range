/* ============ THEME VARIABLES ============ */
.labs-app {
  --navy: #152b3d; --navy-deep: #122536; --ink: #23384a; --muted: #78838c;
  --teal: #098b78; --teal-dark: #057564; --canvas: #f7f8fa; --line: #e4e9ec;
  color: var(--ink); background: var(--canvas); min-height: 100vh;
  font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif; font-size: 14px; line-height: 1.55;
  display: grid; grid-template-columns: 248px minmax(0, 1fr); text-align: left;
}

/* ============ DARK MODE VARIABLES ============ */
.labs-app[data-theme="dark"] {
  --navy: #0a1218; --navy-deep: #060b0f; --ink: #e4e9ec; --muted: #a8b3ba;
  --teal: #08a585; --teal-dark: #068570; --canvas: #0f1419; --line: #2a3138;
}

.labs-app *, .labs-app *::before, .labs-app *::after { box-sizing: border-box; }
.labs-app button, .labs-app input, .labs-app textarea, .labs-app select { font: inherit; }
.labs-app button, .labs-app select { cursor: pointer; }
.labs-app button { color: inherit; }
.labs-app button:disabled { opacity: .5; cursor: not-allowed; }
.labs-app input:disabled, .labs-app textarea:disabled, .labs-app select:disabled { cursor: not-allowed; opacity: .65; }
.labs-app button, .labs-app input, .labs-app select, .labs-app textarea { -webkit-tap-highlight-color: transparent; }
.labs-app :focus-visible { outline: 3px solid #64b9ac; outline-offset: 3px; }
.labs-app h1, .labs-app h2, .labs-app h3, .labs-app p { margin: 0; }
.labs-app h1 { font-size: clamp(27px, 2.5vw, 36px); line-height: 1.25; letter-spacing: -1.1px; font-weight: 650; }
.labs-app h2 { font-size: 18px; line-height: 1.4; letter-spacing: -.35px; font-weight: 650; }
.labs-app h3 { font-size: 16px; line-height: 1.45; font-weight: 650; }
.labs-app svg { flex-shrink: 0; vertical-align: middle; }
.labs-app .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

/* ============ SIDEBAR ============ */
.labs-app .side-rail { background: var(--navy); color: #b8c7d1; min-height: 100vh; padding: 38px 22px 24px; display: flex; flex-direction: column; position: sticky; top: 0; height: 100vh; }
.labs-app[data-theme="dark"] .side-rail { background: var(--navy); color: #c5d3db; }
.labs-app .brand { background: none; border: 0; text-align: left; padding: 0 5px; display: flex; align-items: center; gap: 11px; color: #fff; margin-bottom: 55px; }
.labs-app .brand-symbol { display: flex; align-items: center; justify-content: center; width: 39px; height: 43px; color: #7bdbc4; }
.labs-app[data-theme="dark"] .brand-symbol { color: #6ecfb8; }
.labs-app .brand strong { font-size: 25px; line-height: 1.15; letter-spacing: -.85px; font-weight: 650; display: block; }
.labs-app .brand-dot { color: #68d6bb; }
.labs-app[data-theme="dark"] .brand-dot { color: #5bcfad; }
.labs-app .brand small { font-size: 8px; letter-spacing: 2.9px; font-weight: 600; display: block; margin-top: 8px; color: #95aab9; }
.labs-app[data-theme="dark"] .brand small { color: #7a8d99; }

.labs-app .rail-label { color: #7e96a8; font-size: 9px; letter-spacing: 2px; font-weight: 700; margin: 0 14px 12px; }
.labs-app[data-theme="dark"] .rail-label { color: #6a7d8a; }
.labs-app .rail-link { width: 100%; display: flex; align-items: center; gap: 12px; padding: 14px 14px; border: 0; border-radius: 7px; background: transparent; color: #d8e3e9; font-size: 12px; text-align: left; font-weight: 600; }
.labs-app[data-theme="dark"] .rail-link { color: #c5d3db; }
.labs-app .rail-link.active { background: #203e50; color: #99e4d2; box-shadow: inset 3px 0 #4dc2a9; }
.labs-app[data-theme="dark"] .rail-link.active { background: #1a3544; color: #7dd6c6; box-shadow: inset 3px 0 #48b399; }
.labs-app .rail-note { margin: auto 10px 36px; padding-top: 60px; }
.labs-app .rail-note-icon { width: 35px; height: 35px; display: grid; place-items: center; border: 1px solid #385164; border-radius: 9px; color: #80c8ba; margin-bottom: 17px; }
.labs-app[data-theme="dark"] .rail-note-icon { border-color: #2a4958; color: #6db8aa; }
.labs-app .rail-note strong { font-size: 12px; color: #d3dfe6; font-weight: 600; }
.labs-app[data-theme="dark"] .rail-note strong { color: #c5d3db; }
.labs-app .rail-note p { color: #96aab8; font-size: 11px; line-height: 1.9; margin-top: 8px; }
.labs-app[data-theme="dark"] .rail-note p { color: #7a8d99; }
.labs-app .rail-profile { border-top: 1px solid #304859; padding: 22px 8px 0; display: flex; align-items: center; gap: 11px; }
.labs-app[data-theme="dark"] .rail-profile { border-top-color: #2a3f4a; }
.labs-app .avatar { display: grid; place-items: center; width: 35px; height: 35px; background: #355565; color: #d5eee7; border: 1px solid #486775; border-radius: 50%; font-size: 13px; }
.labs-app[data-theme="dark"] .avatar { background: #2a4958; color: #c5ddd4; border-color: #3a556a; }
.labs-app .rail-profile strong { color: #e4ecf2; font-size: 11px; display: block; font-weight: 600; }
.labs-app[data-theme="dark"] .rail-profile strong { color: #d8e3e9; }
.labs-app .rail-profile div > span { display: block; font-size: 10px; color: #8fa7b6; margin-top: 2px; }
.labs-app[data-theme="dark"] .rail-profile div > span { color: #708395; }

/* ============ TOPBAR ============ */
.labs-app .main-shell { min-width: 0; display: flex; flex-direction: column; }
.labs-app .topbar { min-height: 86px; border-bottom: 1px solid var(--line); background: #fff; padding: 18px 42px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
.labs-app[data-theme="dark"] .topbar { background: #1a1f27; border-bottom-color: var(--line); }
.labs-app .topbar-controls { display: flex; align-items: center; gap: 12px; }
.labs-app .breadcrumb { display: flex; gap: 14px; font-size: 11px; white-space: nowrap; color: #85909a; }
.labs-app[data-theme="dark"] .breadcrumb { color: #7a8595; }
.labs-app .breadcrumb strong { color: #455866; font-weight: 500; }
.labs-app[data-theme="dark"] .breadcrumb strong { color: #c5d3db; }

/* ============ THEME TOGGLE ============ */
.labs-app .theme-toggle { background: transparent; border: 0; color: #8b9d94; display: inline-flex; align-items: center; justify-content: center; border-radius: 5px; width: 31px; height: 33px; padding: 0; flex-shrink: 0; transition: background .15s, color .15s; }
.labs-app .theme-toggle:hover:not(:disabled) { background: #edf3f4; color: var(--ink); }
.labs-app[data-theme="dark"] .theme-toggle { color: #7a8595; }
.labs-app[data-theme="dark"] .theme-toggle:hover:not(:disabled) { background: #2a3138; color: #c5d3db; }

.labs-app .development-control { display: flex; align-items: center; gap: 16px; }
.labs-app .development-badge { font-size: 10px; font-weight: 600; color: #907029; background: #fcf6e6; padding: 5px 9px; border: 1px solid #eee1ba; border-radius: 4px; white-space: nowrap; }
.labs-app[data-theme="dark"] .development-badge { color: #d4a84d; background: #2a2515; border-color: #4a3f1a; }
.labs-app .development-badge i { display: inline-block; width: 5px; height: 5px; border-radius: 50%; margin-right: 5px; background: #be943a; vertical-align: middle; }
.labs-app[data-theme="dark"] .development-badge i { background: #d4a84d; }
.labs-app .identity-select select { max-width: 210px; font-size: 11px; color: #445967; border: 1px solid var(--line); border-radius: 5px; background: #fff; padding: 9px 27px 9px 10px; }
.labs-app[data-theme="dark"] .identity-select select { color: #c5d3db; background: #2a3138; border-color: var(--line); }

/* ============ MAIN CONTENT ============ */
.labs-app .main-content { padding: 39px 42px 48px; max-width: 1500px; width: 100%; margin-inline: auto; flex: 1; }
.labs-app .page-footer { margin: auto 42px 0; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 15px; padding: 20px 0; color: #95a0a8; font-size: 10px; letter-spacing: .3px; }
.labs-app[data-theme="dark"] .page-footer { color: #7a8595; }

/* ============ HEADINGS & TYPOGRAPHY ============ */
.labs-app .page-heading { display: flex; justify-content: space-between; align-items: center; gap: 30px; margin-bottom: 32px; }
.labs-app .eyebrow { font-size: 9px; font-weight: 700; letter-spacing: 1.8px; color: var(--teal); margin-bottom: 11px; text-transform: uppercase; }
.labs-app .page-heading p { margin-top: 12px; color: var(--muted); font-size: 13px; max-width: 680px; }

/* ============ BUTTONS ============ */
.labs-app .button { border: 1px solid transparent; border-radius: 6px; min-height: 43px; padding: 11px 17px; font-size: 12px; font-weight: 600; display: inline-flex; align-items: center; justify-content: center; gap: 9px; text-decoration: none; white-space: nowrap; transition: background .15s, border-color .15s; }
.labs-app .button.primary { background: var(--teal); color: #fff; border-color: var(--teal); box-shadow: 0 3px 5px #098b780b; }
.labs-app .button.primary:hover:not(:disabled) { background: var(--teal-dark); border-color: var(--teal-dark); }
.labs-app .button.secondary { background: #fff; color: #445b69; border-color: #dce4e8; }
.labs-app[data-theme="dark"] .button.secondary { background: #2a3138; color: #c5d3db; border-color: var(--line); }
.labs-app .button.secondary:hover:not(:disabled) { background: #f3f8f7; border-color: #a6c8c0; }
.labs-app[data-theme="dark"] .button.secondary:hover:not(:disabled) { background: #3a4553; border-color: #4a5a6b; }
.labs-app .button.small { min-height: 36px; padding: 8px 12px; font-size: 11px; }
.labs-app .button.full { width: 100%; }
.labs-app .icon-button { background: transparent; border: 0; color: #7b8c99; display: inline-flex; align-items: center; justify-content: center; border-radius: 5px; width: 31px; height: 33px; padding: 0; flex-shrink: 0; }
.labs-app .icon-button:hover:not(:disabled) { background: #edf3f4; color: var(--ink); }
.labs-app[data-theme="dark"] .icon-button { color: #7a8595; }
.labs-app[data-theme="dark"] .icon-button:hover:not(:disabled) { background: #2a3138; color: #c5d3db; }
.labs-app .danger-text { color: #b46c67; }
.labs-app .danger-text:hover:not(:disabled) { color: #a83c34; background: #fff0ed; }
.labs-app[data-theme="dark"] .danger-text { color: #d98270; }
.labs-app[data-theme="dark"] .danger-text:hover:not(:disabled) { color: #e89885; background: #3a2521; }
.labs-app .text-button { border: 0; background: none; padding: 0; color: var(--teal); font-size: 12px; display: inline-flex; align-items: center; gap: 7px; font-weight: 600; }
.labs-app .back-button { border: 0; background: none; display: inline-flex; align-items: center; gap: 8px; color: #758994; padding: 0; font-size: 11px; margin-bottom: 26px; }
.labs-app[data-theme="dark"] .back-button { color: #7a8595; }
.labs-app .back-button:hover { color: var(--teal); }

/* ============ CATALOG ============ */
.labs-app .catalog-summary { display: flex; padding: 23px 29px; margin-bottom: 34px; background: #fff; border: 1px solid var(--line); border-radius: 9px; gap: 0; }
.labs-app[data-theme="dark"] .catalog-summary { background: #1a1f27; }
.labs-app .catalog-summary > div:not(.summary-note) { display: flex; align-items: center; gap: 15px; padding-right: 36px; margin-right: 36px; border-right: 1px solid var(--line); }
.labs-app .catalog-summary strong { font-size: 31px; font-weight: 600; letter-spacing: -1.3px; line-height: 1; }
.labs-app .catalog-summary span { color: #87929a; font-size: 11px; max-width: 75px; }
.labs-app[data-theme="dark"] .catalog-summary span { color: #7a8595; }
.labs-app .summary-note { display: flex; align-items: center; gap: 15px; margin-left: auto; color: #76968e; }
.labs-app[data-theme="dark"] .summary-note { color: #6a8077; }
.labs-app .summary-note p { max-width: 250px; font-size: 11px; color: #81938f; }
.labs-app[data-theme="dark"] .summary-note p { color: #6a8077; }

.labs-app .catalog-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 23px; }
.labs-app .section-title { display: flex; align-items: center; gap: 11px; }
.labs-app .section-title h2 { font-size: 16px; }
.labs-app .section-title > span, .labs-app .count-pill { display: inline-flex; align-items: center; justify-content: center; min-width: 24px; height: 22px; border-radius: 5px; background: #eaf0f2; color: #788c98; padding: 0 6px; font-size: 10px; font-weight: 600; }
.labs-app[data-theme="dark"] .count-pill { background: #2a3544; color: #7a8595; }
.labs-app .catalog-filters { display: flex; gap: 11px; }
.labs-app .search-box { display: flex; align-items: center; gap: 8px; background: #fff; border: 1px solid #e0e6eb; border-radius: 6px; padding: 9px 12px; color: #97a5af; }
.labs-app[data-theme="dark"] .search-box { background: #2a3138; border-color: var(--line); color: #7a8595; }
.labs-app .search-box input { background: transparent; border: 0; outline: 0; width: 160px; min-width: 0; color: var(--ink); font-size: 11px; }
.labs-app .search-box:focus-within { outline: 2px solid #72baad; }
.labs-app .search-box input:focus-visible { outline: 0; }
.labs-app input::placeholder, .labs-app textarea::placeholder { color: #a0acb5; }
.labs-app[data-theme="dark"] input::placeholder, .labs-app[data-theme="dark"] textarea::placeholder { color: #7a8595; }
.labs-app .catalog-filters > select { border: 1px solid #e0e6eb; background: #fff; border-radius: 6px; padding: 9px 12px; color: #7d8c96; font-size: 11px; }
.labs-app[data-theme="dark"] .catalog-filters > select { background: #2a3138; border-color: var(--line); color: #c5d3db; }

/* ============ LAB GRID & CARDS ============ */
.labs-app .lab-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
.labs-app .lab-card { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 24px 23px 18px; display: flex; flex-direction: column; min-width: 0; transition: border-color .2s, box-shadow .2s; }
.labs-app[data-theme="dark"] .lab-card { background: #1a1f27; }
.labs-app .lab-card:hover { border-color: #c7d8d3; box-shadow: 0 8px 25px #233d5007; }
.labs-app[data-theme="dark"] .lab-card:hover { border-color: #4a5a6b; box-shadow: 0 8px 25px #00000033; }
.labs-app .lab-card-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 21px; min-height: 45px; }
.labs-app .lab-icon { display: flex; align-items: center; justify-content: center; width: 45px; height: 45px; border-radius: 12px; background: #e6f3ee; color: #31977f; flex-shrink: 0; }
.labs-app[data-theme="dark"] .lab-icon { background: #2a3f38; color: #5fc9a8; }
.labs-app .lab-icon-1 { color: #5e7eaf; background: #edf2f9; }
.labs-app[data-theme="dark"] .lab-icon-1 { color: #7b9fd4; background: #2a3547; }
.labs-app .lab-icon-2 { color: #a4835b; background: #f7f1e8; }
.labs-app[data-theme="dark"] .lab-icon-2 { color: #c9a86a; background: #3f372a; }

.labs-app .chips { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.labs-app .chip { border-radius: 4px; padding: 4px 7px; font-size: 9px; line-height: 1.3; font-weight: 600; display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; }
.labs-app .chip i { width: 4px; height: 4px; border-radius: 50%; background: currentColor; }
.labs-app .chip-green, .labs-app .chip-teal { background: #e8f5ee; color: #46937a; }
.labs-app[data-theme="dark"] .chip-green, .labs-app[data-theme="dark"] .chip-teal { background: #2a4038; color: #6ccfb0; }
.labs-app .chip-amber { background: #fbf2df; color: #a38744; }
.labs-app[data-theme="dark"] .chip-amber { background: #3f3820; color: #d4a84d; }
.labs-app .chip-gray { background: #eff1f3; color: #80909b; }
.labs-app[data-theme="dark"] .chip-gray { background: #2a3138; color: #7a8595; }
.labs-app .chip-red { background: #fbe9e7; color: #b3594f; }
.labs-app[data-theme="dark"] .chip-red { background: #3a2521; color: #d98270; }

.labs-app .card-category, .labs-app .category-tag { text-transform: uppercase; letter-spacing: 1px; font-size: 8px; font-weight: 650; color: #8b9aa3; }
.labs-app[data-theme="dark"] .card-category, .labs-app[data-theme="dark"] .category-tag { color: #7a8595; }
.labs-app .category-tag { text-align: right; }
.labs-app .lab-card h3 { font-size: 17px; margin: 7px 0 9px; letter-spacing: -.35px; overflow-wrap: anywhere; }
.labs-app .card-description { font-size: 11px; line-height: 1.8; color: #8b979f; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; min-height: 60px; margin-bottom: 20px; }
.labs-app[data-theme="dark"] .card-description { color: #7a8595; }

.labs-app .lab-meta { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; font-size: 9px; color: #86959f; }
.labs-app[data-theme="dark"] .lab-meta { color: #7a8595; }
.labs-app .lab-meta > span { display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }
.labs-app .difficulty { font-size: 9px; color: #648375; gap: 2px !important; }
.labs-app[data-theme="dark"] .difficulty { color: #7a9685; }
.labs-app .difficulty i { display: inline-block; width: 3px; height: 7px; background: #dce7e1; border-radius: 1px; }
.labs-app[data-theme="dark"] .difficulty i { background: #4a5a6b; }
.labs-app .difficulty i:nth-child(2) { height: 10px; }
.labs-app .difficulty i:nth-child(3) { height: 13px; margin-right: 4px; }
.labs-app .difficulty-Easy i:first-child, .labs-app .difficulty-easy i:first-child { background: #65a383; }
.labs-app[data-theme="dark"] .difficulty-Easy i:first-child, .labs-app[data-theme="dark"] .difficulty-easy i:first-child { background: #7bc69f; }
.labs-app .difficulty-medium i:nth-child(-n+2) { background: #bc9b5b; }
.labs-app[data-theme="dark"] .difficulty-medium i:nth-child(-n+2) { background: #d4a84d; }
.labs-app .difficulty-hard i { background: #bf746c; }
.labs-app[data-theme="dark"] .difficulty-hard i { background: #d98270; }

.labs-app .card-score { display: flex; justify-content: space-between; margin: 18px 0 15px; padding-top: 14px; border-top: 1px solid #edf0f2; font-size: 9px; color: #9aa7ae; }
.labs-app[data-theme="dark"] .card-score { border-top-color: var(--line); color: #7a8595; }
.labs-app .card-score span:first-child { font-weight: 600; color: #739087; }
.labs-app[data-theme="dark"] .card-score span:first-child { color: #8aba9f; }

.labs-app .card-actions { display: flex; align-items: center; gap: 7px; margin-top: auto; }
.labs-app .card-actions > .button:first-child { flex: 1; }
.labs-app .card-actions .icon-button { width: 24px; }
.labs-app .card-open { background: #edf6f3; color: var(--teal); width: 100%; justify-content: space-between; min-height: 38px; font-size: 11px; padding-inline: 13px; }
.labs-app[data-theme="dark"] .card-open { background: #2a3f38; }
.labs-app .card-open:hover { background: #dcf0e8; }
.labs-app[data-theme="dark"] .card-open:hover { background: #3a5147; }

/* ============ EMPTY STATE ============ */
.labs-app .empty-state { background: #fff; border: 1px dashed #d5e0e5; border-radius: 12px; padding: 65px 25px; text-align: center; }
.labs-app[data-theme="dark"] .empty-state { background: #1a1f27; border-color: #3a4553; }
.labs-app .empty-icon { display: grid; place-items: center; margin: 0 auto 23px; width: 64px; height: 64px; background: #edf5f2; color: #63a390; border-radius: 18px; }
.labs-app[data-theme="dark"] .empty-icon { background: #2a3f38; color: #5fc9a8; }
.labs-app .empty-state h2 { font-size: 22px; font-weight: 600; }
.labs-app .empty-state p { max-width: 390px; color: #8a98a1; margin: 12px auto 22px; font-size: 13px; }
.labs-app[data-theme="dark"] .empty-state p { color: #7a8595; }

/* ============ LOADING & NOTICES ============ */
.labs-app .loading-state { display: flex; align-items: center; justify-content: center; min-height: 230px; gap: 14px; color: #85949e; font-size: 13px; }
.labs-app[data-theme="dark"] .loading-state { color: #7a8595; }
.labs-app .spinner { width: 20px; height: 20px; border: 2px solid #dce8e3; border-top-color: var(--teal); border-radius: 50%; animation: labs-spin .7s linear infinite; }
.labs-app[data-theme="dark"] .spinner { border-color: #3a4553; }
@keyframes labs-spin { to { transform: rotate(360deg); } }

.labs-app .notice { display: flex; align-items: flex-start; gap: 12px; border: 1px solid; border-radius: 7px; padding: 14px 16px; margin-bottom: 22px; font-size: 12px; overflow-wrap: anywhere; }
.labs-app .notice p { margin-top: 4px; }
.labs-app .notice .text-button { margin-top: 7px; }
.labs-app .notice > .icon-button { margin-left: auto; margin-top: -5px; margin-bottom: -5px; }
.labs-app .notice-error { color: #a75d4e; border-color: #edcec5; background: #fff3ee; }
.labs-app[data-theme="dark"] .notice-error { color: #d98270; border-color: #3a2521; background: #2a1a15; }
.labs-app .notice-success { color: #2d8971; border-color: #cae6d9; background: #eefaF3; align-items: center; }
.labs-app[data-theme="dark"] .notice-success { color: #7dd6c6; border-color: #2a4038; background: #1a2822; align-items: center; }
.labs-app .field-errors { font-size: 11px; }

/* ============ DETAIL VIEWS ============ */
.labs-app .detail-hero { display: flex; justify-content: space-between; gap: 35px; padding: 35px 40px; background: #eaf2ef; border: 1px solid #dce9e3; border-radius: 12px; margin-bottom: 26px; }
.labs-app[data-theme="dark"] .detail-hero { background: #2a3f38; border-color: #3a5147; }
.labs-app .detail-hero-copy { max-width: 690px; }
.labs-app .detail-hero h1 { font-size: 32px; color: #264c40; }
.labs-app[data-theme="dark"] .detail-hero h1 { color: #a8d5be; }
.labs-app .detail-hero p { font-size: 13px; line-height: 1.9; margin: 15px 0 23px; color: #728d83; }
.labs-app[data-theme="dark"] .detail-hero p { color: #8aba9f; }
.labs-app .detail-hero .lab-meta { font-size: 11px; gap: 24px; color: #6d897d; }
.labs-app[data-theme="dark"] .detail-hero .lab-meta { color: #8aba9f; }
.labs-app .detail-hero .difficulty { font-size: 11px; }
.labs-app .detail-hero-mark { width: 155px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 15px; color: #a4cbbc; }
.labs-app[data-theme="dark"] .detail-hero-mark { color: #6fa888; }
.labs-app .detail-hero-mark span { font-size: 8px; letter-spacing: 2px; font-weight: 700; }

.labs-app .management-bar { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin: -6px 0 27px; }
.labs-app .management-actions { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
.labs-app .detail-layout { display: grid; grid-template-columns: minmax(0, 1fr) 290px; gap: 25px; align-items: start; }
.labs-app .detail-main, .labs-app .detail-sidebar { display: flex; flex-direction: column; gap: 22px; min-width: 0; }

/* ============ CONTENT PANELS ============ */
.labs-app .content-panel { background: #fff; border: 1px solid var(--line); border-radius: 9px; padding: 27px; }
.labs-app[data-theme="dark"] .content-panel { background: #1a1f27; }
.labs-app .content-panel > h2 { font-size: 15px; margin-bottom: 18px; }
.labs-app .content-panel > p { color: #7b8d98; font-size: 12px; line-height: 1.9; }
.labs-app[data-theme="dark"] .content-panel > p { color: #7a8595; }
.labs-app .panel-heading { display: flex; align-items: center; gap: 10px; color: #6d9287; margin-bottom: 22px; }
.labs-app[data-theme="dark"] .panel-heading { color: #7a9685; }
.labs-app .panel-heading h2 { color: var(--ink); font-size: 16px; }

.labs-app .objective-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px; }
.labs-app .objective-list li { display: flex; gap: 11px; align-items: flex-start; color: #7a8b97; font-size: 12px; }
.labs-app[data-theme="dark"] .objective-list li { color: #7a8595; }
.labs-app .objective-list svg { color: #56a58d; margin-top: 2px; }
.labs-app[data-theme="dark"] .objective-list svg { color: #6fa888; }

.labs-app .preserve-text { white-space: pre-wrap; overflow-wrap: anywhere; }
.labs-app .muted { color: #93a0a9; font-size: 12px; }
.labs-app[data-theme="dark"] .muted { color: #7a8595; }

.labs-app .task-preview-list article { display: flex; align-items: flex-start; gap: 14px; padding: 19px 0; border-top: 1px solid #edf0f3; }
.labs-app[data-theme="dark"] .task-preview-list article { border-top-color: var(--line); }
.labs-app .task-preview-list article:first-child { padding-top: 0; border-top: 0; }
.labs-app .task-preview-list article:last-child { padding-bottom: 0; }

.labs-app .task-number { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; background: #eef3f5; color: #88a0ac; border-radius: 8px; font-size: 11px; font-weight: 600; flex-shrink: 0; }
.labs-app[data-theme="dark"] .task-number { background: #2a3f48; color: #7a9fa8; }
.labs-app .task-preview-list article > div { flex: 1; min-width: 0; }
.labs-app .task-preview-list h3 { font-size: 13px; }
.labs-app .task-preview-list p { color: #87959e; font-size: 11px; margin-top: 4px; line-height: 1.8; white-space: pre-wrap; overflow-wrap: anywhere; }
.labs-app[data-theme="dark"] .task-preview-list p { color: #7a8595; }
.labs-app .task-preview-list small { color: #779789; display: block; font-size: 10px; margin-top: 8px; }
.labs-app[data-theme="dark"] .task-preview-list small { color: #6a8077; }

.labs-app .task-points { color: #759e8e; font-size: 10px; font-weight: 600; background: #f0f7f3; border-radius: 4px; padding: 4px 7px; white-space: nowrap; }
.labs-app[data-theme="dark"] .task-points { color: #8aba9f; background: #2a3f38; }

.labs-app .start-panel h2 { font-size: 21px; margin-bottom: 13px; letter-spacing: -.5px; line-height: 1.4; }
.labs-app .detail-facts { display: flex; flex-direction: column; gap: 11px; padding: 22px 0; margin: 21px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.labs-app .detail-facts > div { display: flex; justify-content: space-between; gap: 12px; font-size: 11px; }
.labs-app .detail-facts span { color: #84939d; }
.labs-app[data-theme="dark"] .detail-facts span { color: #7a8595; }
.labs-app .detail-facts strong { font-weight: 600; color: #4b6775; }
.labs-app[data-theme="dark"] .detail-facts strong { color: #a8d5be; }

.labs-app .small-note { font-size: 10px !important; color: #97a4ac !important; line-height: 1.8 !important; margin-top: 14px !important; }
.labs-app[data-theme="dark"] .small-note { color: #7a8595 !important; }
.labs-app .start-panel .small-note { text-align: center; }

.labs-app .tool-tags { display: flex; flex-wrap: wrap; gap: 7px; }
.labs-app .tool-tags > span { font-size: 10px; background: #f2f5f7; color: #7c91a0; border: 1px solid #e5ebef; padding: 4px 9px; border-radius: 4px; }
.labs-app[data-theme="dark"] .tool-tags > span { background: #2a3138; color: #7a8595; border-color: var(--line); }

/* ============ BUILDER ============ */
.labs-app .builder-heading { align-items: flex-end; margin-bottom: 30px; }
.labs-app .builder-heading h1 { font-size: 31px; }
.labs-app .save-indicator { font-size: 10px; color: #8b9d94; white-space: nowrap; display: flex; align-items: center; gap: 7px; padding-bottom: 4px; }
.labs-app[data-theme="dark"] .save-indicator { color: #6a8077; }
.labs-app .save-indicator i { background: #9ebdae; width: 5px; height: 5px; border-radius: 50%; }
.labs-app[data-theme="dark"] .save-indicator i { background: #7a9685; }
.labs-app .save-indicator.unsaved { color: #ae965b; }
.labs-app[data-theme="dark"] .save-indicator.unsaved { color: #d4a84d; }
.labs-app .save-indicator.unsaved i { background: #c9ae6d; }
.labs-app[data-theme="dark"] .save-indicator.unsaved i { background: #d4a84d; }

.labs-app .builder-layout { display: grid; grid-template-columns: minmax(0, 1fr) 270px; align-items: start; gap: 26px; }
.labs-app .builder-main { display: flex; flex-direction: column; gap: 24px; min-width: 0; }
.labs-app .builder-section { padding: 28px 30px 31px; }
.labs-app .builder-section-heading { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 24px; }
.labs-app .section-index { display: flex; justify-content: center; align-items: center; flex-shrink: 0; width: 32px; height: 32px; border-radius: 7px; background: #edf5f1; color: #7ba893; font-size: 10px; font-weight: 600; margin-top: 1px; }
.labs-app[data-theme="dark"] .section-index { background: #2a3f38; color: #7a9685; }
.labs-app .builder-section-heading h2 { font-size: 17px; }
.labs-app .builder-section-heading p { font-size: 11px; color: #97a3aa; margin-top: 4px; }
.labs-app[data-theme="dark"] .builder-section-heading p { color: #7a8595; }
.labs-app .builder-section-heading > .count-pill { margin-left: auto; margin-top: 4px; }

.labs-app .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
.labs-app .span-2 { grid-column: span 2; }
.labs-app .field { display: flex; flex-direction: column; gap: 7px; font-size: 11px; color: #576d7b; font-weight: 600; min-width: 0; }
.labs-app[data-theme="dark"] .field { color: #7a8595; }
.labs-app .field input, .labs-app .field textarea, .labs-app .field select { border: 1px solid #dde5e9; border-radius: 5px; padding: 11px 12px; color: #3d5c6e; background: #fff; font-size: 12px; font-weight: 400; line-height: 1.65; width: 100%; min-width: 0; transition: border-color .15s; }
.labs-app[data-theme="dark"] .field input, .labs-app[data-theme="dark"] .field textarea, .labs-app[data-theme="dark"] .field select { background: #2a3138; border-color: var(--line); color: #c5d3db; }
.labs-app .field textarea { resize: vertical; min-height: 67px; }
.labs-app .field input:hover, .labs-app .field textarea:hover, .labs-app .field select:hover { border-color: #b6c9c5; }
.labs-app[data-theme="dark"] .field input:hover, .labs-app[data-theme="dark"] .field textarea:hover, .labs-app[data-theme="dark"] .field select:hover { border-color: #4a5a6b; }
.labs-app .field small { font-size: 10px; font-weight: 400; color: #98a5ad; line-height: 1.7; }
.labs-app[data-theme="dark"] .field small { color: #7a8595; }

.labs-app .builder-sidebar { position: sticky; top: 24px; }
.labs-app .publish-panel { padding: 26px 23px; }
.labs-app .publish-panel > h2 { font-size: 18px; margin-bottom: 13px; overflow-wrap: anywhere; }
.labs-app .publish-panel > .button + .button { margin-top: 10px; }

.labs-app .check-field { display: flex; align-items: center; gap: 8px; color: #607987; font-size: 11px; font-weight: 400; cursor: pointer; }
.labs-app[data-theme="dark"] .check-field { color: #7a8595; }
.labs-app .check-field input { accent-color: var(--teal); width: 15px; height: 15px; margin: 0; flex-shrink: 0; }
.labs-app .enabled-toggle { align-items: flex-start; margin-bottom: 24px; color: #556d7c; font-weight: 600; }
.labs-app[data-theme="dark"] .enabled-toggle { color: #c5d3db; }
.labs-app .enabled-toggle input { margin-top: 1px; }
.labs-app .enabled-toggle small { display: block; color: #94a2aa; font-size: 10px; font-weight: 400; margin-top: 3px; }
.labs-app[data-theme="dark"] .enabled-toggle small { color: #7a8595; }

.labs-app .builder-tip { display: flex; gap: 12px; margin: 24px 5px 0; color: #92a599; }
.labs-app[data-theme="dark"] .builder-tip { color: #6a8077; }
.labs-app .builder-tip strong { font-size: 11px; color: #7b9285; font-weight: 600; }
.labs-app[data-theme="dark"] .builder-tip strong { color: #7a9685; }
.labs-app .builder-tip p { font-size: 10px; margin-top: 7px; line-height: 1.9; color: #9aaba2; }
.labs-app[data-theme="dark"] .builder-tip p { color: #6a8077; }

.labs-app .tasks-builder { padding: 7px 0 0; }
.labs-app .tasks-builder > .builder-section-heading { margin-inline: 3px; }
.labs-app .empty-tasks { padding: 34px 22px; text-align: center; background: #fff; border: 1px dashed #d9e3e7; border-radius: 8px; color: #9ab3a8; margin-bottom: 17px; }
.labs-app[data-theme="dark"] .empty-tasks { background: #1a1f27; border-color: #3a4553; color: #6a8077; }
.labs-app .empty-tasks h3 { color: #80978e; font-size: 13px; margin-top: 13px; }
.labs-app[data-theme="dark"] .empty-tasks h3 { color: #7a9685; }
.labs-app .empty-tasks p { color: #a0aea7; font-size: 11px; margin-top: 6px; }
.labs-app[data-theme="dark"] .empty-tasks p { color: #6a8077; }

.labs-app .task-editor { margin: 0 0 22px; padding: 15px 27px 27px; background: #fff; border: 1px solid #dfe7e9; border-radius: 9px; min-width: 0; }
.labs-app[data-theme="dark"] .task-editor { background: #1a1f27; border-color: var(--line); }
.labs-app .task-editor legend { font-size: 11px; font-weight: 600; letter-spacing: .3px; padding: 0 9px; color: #6b8c7e; }
.labs-app[data-theme="dark"] .task-editor legend { color: #7a9685; }
.labs-app .task-editor-toolbar { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #edf1f3; margin-bottom: 21px; padding-bottom: 13px; }
.labs-app[data-theme="dark"] .task-editor-toolbar { border-bottom-color: var(--line); }
.labs-app .task-editor-type { color: #9aaba6; font-size: 10px; }
.labs-app[data-theme="dark"] .task-editor-type { color: #7a8595; }
.labs-app .task-editor-toolbar > div { display: flex; gap: 2px; }
.labs-app .task-options { display: flex; gap: 24px; flex-wrap: wrap; border-top: 1px solid #edf1f3; padding-top: 17px; }
.labs-app[data-theme="dark"] .task-options { border-top-color: var(--line); }

.labs-app .add-task-button { display: flex; align-items: center; justify-content: center; gap: 10px; border: 1px dashed #a7c7bb; background: #f0f7f4; color: #5f9882; border-radius: 7px; width: 100%; min-height: 50px; font-size: 12px; font-weight: 600; }
.labs-app[data-theme="dark"] .add-task-button { border-color: #4a5f55; background: #2a3f38; color: #7a9685; }
.labs-app .add-task-button:hover:not(:disabled) { background: #e5f2ec; }
.labs-app[data-theme="dark"] .add-task-button:hover:not(:disabled) { background: #3a5147; }

/* ============ WORKSPACE ============ */
.labs-app .workspace-heading { align-items: flex-start; }
.labs-app .workspace-heading .chip { margin-top: 6px; padding: 7px 10px; }

.labs-app .attempt-progress { display: flex; gap: 0; background: #fff; border: 1px solid var(--line); padding: 25px 31px; margin-bottom: 31px; border-radius: 9px; align-items: center; }
.labs-app[data-theme="dark"] .attempt-progress { background: #1a1f27; }
.labs-app .progress-stat { min-width: 155px; padding-right: 32px; margin-right: 32px; border-right: 1px solid var(--line); }
.labs-app .progress-stat > span { color: #879da8; font-size: 10px; display: block; margin-bottom: 8px; }
.labs-app[data-theme="dark"] .progress-stat > span { color: #7a8595; }
.labs-app .progress-stat > strong { font-size: 28px; line-height: 1.2; letter-spacing: -.8px; font-weight: 600; }
.labs-app .progress-stat small { font-size: 17px; color: #a3b1ba; font-weight: 400; }
.labs-app[data-theme="dark"] .progress-stat small { color: #7a8595; }

.labs-app .progress-meter { flex: 1; min-width: 0; }
.labs-app .progress-meter > div:first-child { display: flex; justify-content: space-between; font-size: 10px; margin-bottom: 10px; color: #869ca6; }
.labs-app[data-theme="dark"] .progress-meter > div:first-child { color: #7a8595; }
.labs-app .progress-meter strong { color: #4e9781; }
.labs-app[data-theme="dark"] .progress-meter strong { color: #7dd6c6; }
.labs-app .progress-track { height: 6px; background: #edf3f0; border-radius: 10px; overflow: hidden; }
.labs-app[data-theme="dark"] .progress-track { background: #2a3f48; }
.labs-app .progress-track > span { height: 100%; display: block; background: #56ad90; border-radius: inherit; transition: width .3s; }
.labs-app[data-theme="dark"] .progress-track > span { background: #7dd6c6; }
.labs-app .progress-meter > small { font-size: 9px; color: #a0b0b7; display: block; margin-top: 8px; }
.labs-app[data-theme="dark"] .progress-meter > small { color: #7a8595; }

.labs-app .workspace-layout { display: grid; grid-template-columns: minmax(0, 1fr) 290px; gap: 25px; align-items: start; }
.labs-app .workspace-tasks { min-width: 0; }
.labs-app .workspace-tasks > .section-title { margin-bottom: 20px; }
.labs-app .workspace-task { padding: 26px; background: #fff; border: 1px solid var(--line); border-radius: 9px; margin-bottom: 21px; }
.labs-app[data-theme="dark"] .workspace-task { background: #1a1f27; }
.labs-app .workspace-task > header { display: flex; align-items: center; gap: 13px; margin-bottom: 22px; }
.labs-app .workspace-task header > div { min-width: 0; }
.labs-app .task-kicker { color: #9caeb6; letter-spacing: 1.4px; font-size: 8px; font-weight: 600; display: block; margin-bottom: 4px; }
.labs-app[data-theme="dark"] .task-kicker { color: #7a8595; }
.labs-app .workspace-task h3 { font-size: 16px; overflow-wrap: anywhere; }
.labs-app .workspace-task header > .task-points { margin-left: auto; }
.labs-app .workspace-task > p { color: #80939e; font-size: 12px; line-height: 1.9; }
.labs-app[data-theme="dark"] .workspace-task > p { color: #7a8595; }

.labs-app .requirements { margin-top: 17px; padding: 14px 16px; border-left: 2px solid #d6e5dd; background: #f7faf8; border-radius: 0 4px 4px 0; }
.labs-app[data-theme="dark"] .requirements { border-left-color: #3a5147; background: #2a3f38; }
.labs-app .requirements strong { font-size: 10px; color: #6d8c7c; font-weight: 600; }
.labs-app[data-theme="dark"] .requirements strong { color: #7a9685; }
.labs-app .requirements p { color: #90a397; font-size: 11px; margin-top: 5px; line-height: 1.8; }
.labs-app[data-theme="dark"] .requirements p { color: #6a8077; }

.labs-app .locked-note { display: flex; align-items: center; gap: 7px; color: #9c9279; font-size: 10px; padding: 12px 0; }
.labs-app[data-theme="dark"] .locked-note { color: #8a7f70; }

.labs-app .hints { margin: 18px 0; }
.labs-app .hints .text-button { color: #8e9d8f; font-size: 10px; }
.labs-app[data-theme="dark"] .hints .text-button { color: #6a8077; }
.labs-app .hints .text-button > span { color: #a0b19e; font-weight: 400; }
.labs-app[data-theme="dark"] .hints .text-button > span { color: #7a8595; }
.labs-app .hints ol { margin: 13px 0 0; padding: 14px 16px 14px 31px; background: #faf8ed; border-radius: 5px; color: #9a926f; font-size: 11px; line-height: 1.8; }
.labs-app[data-theme="dark"] .hints ol { background: #2a2515; color: #b5a876; }
.labs-app .hints li + li { margin-top: 7px; }

.labs-app .task-submission { margin-top: 22px; padding-top: 20px; border-top: 1px solid #edf1f3; display: flex; align-items: flex-end; gap: 12px; }
.labs-app[data-theme="dark"] .task-submission { border-top-color: var(--line); }
.labs-app .task-submission .field { flex: 1; }
.labs-app .task-submission .field input { min-height: 43px; }
.labs-app .task-submission .button { font-size: 11px; }

.labs-app .completed-number { background: #e7f3eb; color: #6eae90; }
.labs-app[data-theme="dark"] .completed-number { background: #2a4038; color: #7dd6c6; }
.labs-app .task-completed { border-color: #d4e5da; }
.labs-app[data-theme="dark"] .task-completed { border-color: #3a5147; }
.labs-app .completed-button { background: #edf6ef; color: #6b9b7d; opacity: 1; }
.labs-app[data-theme="dark"] .completed-button { background: #2a4038; color: #7dd6c6; opacity: 1; }
.labs-app .task-locked { background: #fcfcfd; }
.labs-app[data-theme="dark"] .task-locked { background: #0f1419; }
.labs-app .task-locked > header { opacity: .65; }

.labs-app .submission-feedback { margin-top: 13px; font-size: 11px; }
.labs-app .submission-feedback.correct { color: #53a180; }
.labs-app[data-theme="dark"] .submission-feedback.correct { color: #7dd6c6; }
.labs-app .submission-feedback.incorrect { color: #b77662; }
.labs-app[data-theme="dark"] .submission-feedback.incorrect { color: #d98270; }

.labs-app .workspace-sidebar { display: flex; flex-direction: column; gap: 21px; padding-top: 43px; min-width: 0; }
.labs-app .workspace-sidebar .content-panel { padding: 24px; }
.labs-app .workspace-sidebar .content-panel > h2, .labs-app .workspace-sidebar .panel-heading h2 { font-size: 14px; }
.labs-app .workspace-sidebar .content-panel > p, .labs-app .workspace-sidebar .objective-list li { font-size: 11px; }
.labs-app .workspace-update-note { color: #a2aea9; font-size: 10px; line-height: 1.9; padding-inline: 6px; }
.labs-app[data-theme="dark"] .workspace-update-note { color: #6a8077; }

.labs-app .completion-banner { display: flex; gap: 17px; align-items: center; background: #edf7f0; border: 1px solid #d6e9d9; border-radius: 9px; padding: 22px 27px; margin-bottom: 27px; }
.labs-app[data-theme="dark"] .completion-banner { background: #2a4038; border-color: #3a5147; }
.labs-app .completion-banner > span { display: grid; place-items: center; width: 45px; height: 45px; background: #d9eedf; color: #64a67b; border-radius: 50%; flex-shrink: 0; }
.labs-app[data-theme="dark"] .completion-banner > span { background: #3a5147; color: #7dd6c6; }
.labs-app .completion-banner h2 { font-size: 18px; color: #56826a; }
.labs-app[data-theme="dark"] .completion-banner h2 { color: #a8d5be; }
.labs-app .completion-banner p { color: #8daa97; font-size: 11px; margin-top: 4px; }
.labs-app[data-theme="dark"] .completion-banner p { color: #8aba9f; }
.labs-app .completion-banner > button { margin-left: auto; }

/* ============ RUNTIME ============ */
.labs-app .runtime-panel { margin-bottom: 28px; }
.labs-app .runtime-body { display: grid; gap: 14px; }
.labs-app .runtime-actions { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
.labs-app .runtime-actions > div { display: flex; align-items: center; gap: 9px; }
.labs-app .kali-frame { width: 100%; aspect-ratio: 16 / 9; min-height: 480px; border: 1px solid var(--line); border-radius: 8px; background: #0b1117; }
.labs-app .runtime-placeholder { min-height: 210px; display: grid; place-items: center; align-content: center; gap: 12px; color: #7c8c96; border: 1px dashed #d5e0e5; border-radius: 8px; padding: 25px; text-align: center; }
.labs-app[data-theme="dark"] .runtime-placeholder { color: #7a8595; border-color: #3a4553; }
.labs-app .runtime-placeholder p { max-width: 480px; font-size: 12px; color: #83919b; }
.labs-app[data-theme="dark"] .runtime-placeholder p { color: #7a8595; }

.labs-app .button.danger { background: #a83c34; color: #fff; border-color: #a83c34; }
.labs-app .button.danger:hover:not(:disabled) { background: #8f2f28; border-color: #8f2f28; }

/* ============ RESPONSIVE ============ */
@media (min-width: 1600px) { .labs-app .lab-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .labs-app .main-content { padding-top: 47px; } }
@media (max-width: 1250px) {
  .labs-app { grid-template-columns: 210px minmax(0, 1fr); }
  .labs-app .side-rail { padding-inline: 17px; }
  .labs-app .brand { gap: 7px; padding-inline: 1px; }
  .labs-app .brand strong { font-size: 22px; }
  .labs-app .main-content { padding-inline: 30px; }
  .labs-app .topbar { padding-inline: 30px; }
  .labs-app .page-footer { margin-inline: 30px; }
  .labs-app .lab-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .labs-app .catalog-summary > div:not(.summary-note) { padding-right: 22px; margin-right: 22px; }
  .labs-app .summary-note p { max-width: 180px; }
  .labs-app .detail-layout, .labs-app .workspace-layout { grid-template-columns: minmax(0, 1fr) 250px; gap: 20px; }
  .labs-app .builder-layout { grid-template-columns: minmax(0, 1fr) 240px; gap: 20px; }
  .labs-app .builder-section, .labs-app .task-editor { padding-inline: 23px; }
  .labs-app .content-panel { padding: 23px; }
  .labs-app .progress-stat { min-width: 125px; padding-right: 22px; margin-right: 22px; }
  .labs-app .task-submission { flex-wrap: wrap; }
  .labs-app .task-submission .field { flex-basis: 100%; }
}
@media (max-width: 1050px) {
  .labs-app { grid-template-columns: 185px minmax(0, 1fr); }
  .labs-app .side-rail { padding-inline: 12px; }
  .labs-app .brand strong { font-size: 20px; }
  .labs-app .brand small { font-size: 7px; letter-spacing: 2px; }
  .labs-app .brand-symbol { width: 29px; }
  .labs-app .rail-link { font-size: 10px; padding-inline: 10px; gap: 9px; }
  .labs-app .main-content { padding: 30px 25px 40px; }
  .labs-app .topbar { padding-inline: 25px; }
  .labs-app .breadcrumb { display: none; }
  .labs-app .development-control { width: 100%; justify-content: space-between; }
  .labs-app .summary-note { display: none; }
  .labs-app .catalog-summary > div:not(.summary-note) { flex: 1; }
  .labs-app .catalog-summary > div:nth-child(2) { border-right: 0; padding-right: 0; margin-right: 0; }
  .labs-app .builder-layout, .labs-app .detail-layout, .labs-app .workspace-layout { grid-template-columns: minmax(0, 1fr); }
  .labs-app .builder-sidebar { position: static; grid-row: 1; }
  .labs-app .publish-panel { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 22px; }
  .labs-app .publish-panel > .eyebrow { grid-column: span 2; }
  .labs-app .publish-panel > h2 { margin-bottom: 0; }
  .labs-app .publish-panel > .chips { justify-content: flex-end; }
  .labs-app .publish-panel .detail-facts { grid-column: span 2; margin: 17px 0; padding: 15px 0; flex-direction: row; flex-wrap: wrap; gap: 20px; }
  .labs-app .publish-panel .detail-facts > div { gap: 9px; }
  .labs-app .publish-panel .enabled-toggle { grid-column: span 2; margin-bottom: 18px; }
  .labs-app .publish-panel > .button + .button { margin-top: 0; }
  .labs-app .publish-panel > .small-note { grid-column: span 2; }
  .labs-app .builder-tip { display: none; }
  .labs-app .detail-sidebar { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-row: 1; }
  .labs-app .start-panel { grid-column: span 2; }
  .labs-app .detail-sidebar > .content-panel:last-child { grid-column: span 2; }
  .labs-app .detail-hero-mark { width: 110px; }
  .labs-app .management-bar { align-items: flex-start; flex-direction: column; }
  .labs-app .workspace-sidebar { padding-top: 0; }
  .labs-app .task-submission .field { flex-basis: auto; }
}
@media (max-width: 760px) {
  .labs-app { display: block; }
  .labs-app .side-rail { position: static; height: auto; min-height: auto; padding: 16px 20px; display: flex; flex-direction: row; align-items: center; gap: 20px; }
  .labs-app .brand { margin: 0; gap: 7px; }
  .labs-app .brand strong { font-size: 22px; }
  .labs-app .brand small { font-size: 6px; margin-top: 5px; }
  .labs-app .brand-symbol { width: 28px; height: 33px; }
  .labs-app .rail-label, .labs-app .rail-note, .labs-app .rail-profile { display: none; }
  .labs-app .side-rail nav { margin-left: auto; }
  .labs-app .rail-link { font-size: 10px; min-height: 39px; padding-inline: 13px; box-shadow: none; }
  .labs-app .rail-link svg { width: 16px; }
  .labs-app .topbar { min-height: 65px; padding: 13px 23px; }
  .labs-app .development-badge { font-size: 9px; }
  .labs-app .identity-select select { max-width: 200px; font-size: 10px; }
  .labs-app .main-content { padding: 29px 23px 38px; }
  .labs-app .page-heading { align-items: flex-start; gap: 19px; flex-wrap: wrap; margin-bottom: 26px; }
  .labs-app .page-heading > .button { min-height: 37px; padding: 8px 13px; font-size: 11px; }
  .labs-app h1, .labs-app .builder-heading h1 { font-size: 29px; letter-spacing: -.8px; }
  .labs-app .page-heading p { font-size: 12px; line-height: 1.8; }
  .labs-app .catalog-summary { padding: 21px 24px; margin-bottom: 26px; }
  .labs-app .catalog-summary strong { font-size: 28px; }
  .labs-app .catalog-summary > div:not(.summary-note) { gap: 14px; }
  .labs-app .catalog-toolbar { flex-wrap: wrap; gap: 18px; }
  .labs-app .catalog-filters { width: 100%; }
  .labs-app .search-box { flex: 1; min-width: 0; }
  .labs-app .search-box input { width: 100%; }
  .labs-app .lab-grid { gap: 17px; }
  .labs-app .lab-card { padding: 22px 20px 18px; }
  .labs-app .card-actions { gap: 5px; }
  .labs-app .card-actions .button { padding-inline: 9px; }
  .labs-app .card-actions .button svg { display: none; }
  .labs-app .page-footer { margin-inline: 23px; font-size: 9px; }
  .labs-app .detail-hero { padding: 28px; }
  .labs-app .detail-hero h1 { font-size: 27px; }
  .labs-app .detail-hero-mark { display: none; }
  .labs-app .attempt-progress { padding: 23px; flex-wrap: wrap; row-gap: 24px; }
  .labs-app .progress-stat { flex: 1; min-width: 0; margin-right: 20px; padding-right: 20px; }
  .labs-app .progress-stat:nth-child(2) { border-right: 0; margin-right: 0; padding-right: 0; }
  .labs-app .progress-meter { flex-basis: 100%; }
  .labs-app .completion-banner { flex-wrap: wrap; padding: 22px; }
  .labs-app .completion-banner > button { margin-left: 62px; font-size: 11px; }
}
@media (max-width: 520px) {
  .labs-app .side-rail { padding-inline: 17px; gap: 12px; }
  .labs-app .rail-link { padding: 11px 10px; font-size: 9px; gap: 7px; }
  .labs-app .rail-link svg { width: 14px; }
  .labs-app .topbar { padding-inline: 18px; }
  .labs-app .development-control { gap: 10px; }
  .labs-app .identity-select select { max-width: 184px; font-size: 9px; padding-right: 5px; }
  .labs-app .development-badge { font-size: 8px; padding: 5px 6px; }
  .labs-app .main-content { padding: 26px 18px 34px; }
  .labs-app h1, .labs-app .builder-heading h1 { font-size: 27px; }
  .labs-app .eyebrow { font-size: 8px; letter-spacing: 1.5px; }
  .labs-app .catalog-summary { padding: 19px 21px; }
  .labs-app .catalog-summary > div:not(.summary-note) { gap: 11px; margin-right: 15px; padding-right: 15px; }
  .labs-app .catalog-summary > div:nth-child(2) { margin-right: 0; padding-right: 0; }
  .labs-app .catalog-summary span { font-size: 10px; }
  .labs-app .lab-grid { grid-template-columns: minmax(0, 1fr); }
  .labs-app .lab-card { padding: 24px; }
  .labs-app .lab-card .card-description { min-height: auto; }
  .labs-app .lab-meta { gap: 17px; }
  .labs-app .lab-card h3 { font-size: 19px; }
  .labs-app .card-actions .button { min-height: 39px; }
  .labs-app .card-actions .button svg { display: block; }
  .labs-app .card-actions { gap: 8px; }
  .labs-app .card-actions .icon-button { width: 29px; }
  .labs-app .empty-state { padding: 43px 24px; }
  .labs-app .empty-state h2 { font-size: 21px; }
  .labs-app .builder-section, .labs-app .task-editor { padding-inline: 21px; }
  .labs-app .builder-section-heading { gap: 11px; }
  .labs-app .builder-section-heading h2 { font-size: 16px; }
  .labs-app .builder-section-heading p { font-size: 10px; }
  .labs-app .form-grid { grid-template-columns: minmax(0, 1fr); gap: 18px; }
  .labs-app .span-2 { grid-column: span 1; }
  .labs-app .task-options { gap: 16px; }
  .labs-app .publish-panel .detail-facts { flex-direction: column; gap: 10px; }
  .labs-app .publish-panel .detail-facts > div { justify-content: space-between; }
  .labs-app .publish-panel { padding: 23px; }
  .labs-app .publish-panel > .button { font-size: 11px; padding-inline: 10px; }
  .labs-app .save-indicator { font-size: 9px; }
  .labs-app .management-actions { gap: 7px; }
  .labs-app .management-actions .button { font-size: 10px; padding-inline: 10px; }
  .labs-app .management-actions .icon-button { width: 26px; }
  .labs-app .task-preview-list article { gap: 10px; }
  .labs-app .task-points { font-size: 9px; padding: 4px 5px; }
  .labs-app .task-number { width: 30px; height: 32px; }
  .labs-app .workspace-task { padding: 23px 21px; }
  .labs-app .workspace-task > header { gap: 10px; }
  .labs-app .workspace-task h3 { font-size: 15px; }
  .labs-app .task-submission .field { flex-basis: 100%; }
  .labs-app .task-submission .button { width: 100%; }
  .labs-app .completion-banner > button { margin-left: 0; width: 100%; }
  .labs-app .page-footer { margin-inline: 18px; }
  .labs-app .runtime-actions { align-items: flex-start; flex-direction: column; }
  .labs-app .kali-frame { min-height: 300px; }
}
@media (prefers-reduced-motion: reduce) { .labs-app *, .labs-app *::before, .labs-app *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; } }